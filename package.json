{
  "name": "cloudrdr",
  "version": "0.1.0",
  "description": "Cloud Ransomware Detection & Recovery — backend",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "node --watch backend/src/api/server.js",
    "start": "node backend/src/api/server.js",
    "build:c": "powershell -ExecutionPolicy Bypass -File agent-c/build.ps1",
    "monitor": "node scripts/run-monitor.js",
    "seed": "node scripts/seed-baseline.js",
    "simulate": "node scripts/dev-simulate-attack.js",
    "sweep": "node scripts/run-threshold-sweep.js",
    "metrics": "node scripts/run-metrics-harness.js",
    "test": "node --experimental-vm-modules --test \"test/**/*.test.js\"",
    "test:qa": "node test/qa-audit.js",
    "test:all": "npm test && npm run test:qa",
    "lint": "eslint backend/src scripts test",
    "lint:fix": "eslint backend/src scripts test --fix",
    "build:css": "tailwindcss -i frontend/site/css/tailwind-input.css -o frontend/site/css/tailwind.css --minify",
    "dev:css": "tailwindcss -i frontend/site/css/tailwind-input.css -o frontend/site/css/tailwind.css --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@supabase/supabase-js": "^2.43.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "pg": "^8.23.1",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@tailwindcss/cli": "^4.3.3",
    "eslint": "^9.9.0",
    "playwright": "^1.64.1",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.3.3"
  }
}
