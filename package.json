{
  "name": "cloudrdr",
  "version": "0.1.0",
  "description": "Cloud Ransomware Detection & Recovery — backend",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "node --watch src/api/server.js",
    "start": "node src/api/server.js",
    "monitor": "node scripts/run-monitor.js",
    "seed": "node scripts/seed-baseline.js",
    "simulate": "node scripts/dev-simulate-attack.js",
    "sweep": "node scripts/run-threshold-sweep.js",
    "metrics": "node scripts/run-metrics-harness.js",
    "test": "node --experimental-vm-modules --test",
    "lint": "eslint src scripts test",
    "lint:fix": "eslint src scripts test --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.0"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "@eslint/js": "^9.9.0",
    "prettier": "^3.3.3"
  }
}
