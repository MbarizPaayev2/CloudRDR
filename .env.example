# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── Storage ───────────────────────────────────────────────────────────────────
# 'supabase' uses Supabase Storage; 'local' uses local filesystem (demo/tests)
STORAGE_PROVIDER=local
STORAGE_BUCKET=protected
LOCAL_STORAGE_PATH=./data/local-storage

# ── Monitor agent ─────────────────────────────────────────────────────────────
MONITOR_INTERVAL_SECONDS=10

# ── Detection engine ──────────────────────────────────────────────────────────
WINDOW_SECONDS=60
SUSPICIOUS_RATE=0.10
RANSOMWARE_RATE=0.30
# Comma-separated account IDs exempt from bulk-change alerts
ALLOWLISTED_ACCOUNTS=

# ── HTTP API ──────────────────────────────────────────────────────────────────
API_KEY=change-me-before-running
DASHBOARD_ORIGIN=http://localhost:3001
PORT=3000

# ── Logging ───────────────────────────────────────────────────────────────────
# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
